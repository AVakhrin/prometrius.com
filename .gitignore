# Серверный конфиг целиком: содержит домены других сайтов.
# В репозитории ему не место — он живёт на сервере.
default.conf

# Служебный мусор систем и редакторов
.DS_Store
Thumbs.db
*~
*.swp

# =============================================================================
# ЛОГИ СЧЁТЧИКОВ — НЕ В GIT.
# -----------------------------------------------------------------------------
# ПОЧЕМУ. Пишет в них www-data, а приезжают они при деплое под владельцем
# репозитория. После каждой заливки права слетали, и счётчик молча переставал
# считать: читать мог (число видно), писать — нет. Теперь файлы создаются
# сервером при первой записи, владелец больше никогда не меняется.
#
# СТАРТОВОЕ ЗНАЧЕНИЕ (если нужно не с нуля) — ставится ОДИН РАЗ на сервере:
#   echo "[$(date '+%Y-%m-%d %H:%M:%S')] download file=app_obd2-release.apk count=362" \
#     | sudo tee /var/www/prometrius.com/downloads/downloads.log >/dev/null
#   sudo chown www-data:www-data /var/www/prometrius.com/downloads/downloads.log
# =============================================================================
downloads/downloads.log
mod_a/obd2/data/dtc_downloads.log
